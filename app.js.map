[
  {
    "id": "DC-001",
    "typeId": "F02",
    "type": "杀猪盘",
    "title": "优质异性带你投资：从暧昧到收割的完整剧本",
    "difficulty": 2,
    "scenario": "30岁单身男性，交友软件遇到优质异性，被带入投资骗局的全过程",
    "duration": 11,
    "tags": ["杀猪盘", "情感操控", "投资理财", "高收益"],
    "updateDate": "2026-07",
    "severity": 5,
    "script": [
      {
        "from": "scammer",
        "text": "你好呀，看你头像挺阳光的，喜欢健身吗？我平时也爱运动，刚跑完步回来。",
        "tactic": "建立人设",
        "psychology": ["intimacy", "curiosity"],
        "deconstruct": "骗子用假照片打造'优质异性'人设（健身/旅行/美食），开放式提问引导你回复。陌生人过度热情+完美人设=剧本开端。",
        "redFlag": 1
      },
      {
        "from": "scammer",
        "text": "我是做金融分析的，平时工作忙但收入还行。你呢？做什么工作呀？",
        "tactic": "植入身份背景",
        "psychology": ["trust", "intimacy"],
        "deconstruct": "提前铺垫'金融'背景，为后续推荐投资埋伏笔。骗子最爱用人设：金融精英/IT高管/海归创业。正常交友不会主动亮收入。",
        "redFlag": 2
      },
      {
        "from": "scammer",
        "text": "这几天看你朋友圈挺压抑的，是不是工作不顺心？我陪你聊聊，做人嘛开心最重要。",
        "tactic": "情感拉拢",
        "psychology": ["intimacy", "trust"],
        "deconstruct": "主动扮演'知心人'，建立情感依赖。骗子会持续嘘寒问暖数周，待你卸下防备再下手。情感升温越快，风险越高。",
        "redFlag": 2
      },
      {
        "from": "victim",
        "text": "最近确实压力大，有什么副业推荐吗？想多赚点钱。",
        "tactic": "受害者上钩",
        "psychology": ["greed"],
        "deconstruct": "受害者主动询问副业，骗子判断'猪已养肥'，进入收割阶段。这是骗局转折点。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "我舅舅在金融监管单位，发现了系统漏洞，稳赚不赔，但只能内部人参与。我可以带你。",
        "tactic": "利益诱惑+稀缺性",
        "psychology": ["greed", "scarcity", "trust"],
        "deconstruct": "经典话术三件套：①内部消息/漏洞 ②稳赚不赔 ③限定参与。任何'稳赚不赔'都是诈骗，金融监管漏洞不可能让你薅羊毛。",
        "redFlag": 5
      },
      {
        "from": "victim",
        "text": "真的吗？需要多少钱？",
        "tactic": "受害者上钩",
        "psychology": ["greed"],
        "deconstruct": "受害者开始感兴趣，询问门槛。此时骗子已锁定猎物。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "先5000试水，赚到钱你请我吃饭就行。但这件事千万不能告诉别人，监管查到就麻烦了。",
        "tactic": "小额试水+保密要求",
        "psychology": ["trust", "fear", "conformity"],
        "deconstruct": "①小额试水是诱饵，让你尝到甜头 ②保密要求切断你寻求帮助的渠道。任何'保密参与'都是诈骗，正规投资无保密要求。",
        "redFlag": 5
      },
      {
        "from": "system",
        "text": "三天后，账户显示盈利2000元，提现秒到账。",
        "tactic": "制造甜头",
        "psychology": ["trust", "sunkCost"],
        "deconstruct": "小额返利是骗局关键环节，让你建立'平台可信'的错觉。骗子的钱就是诱饵，目的是钓大鱼。返利越顺，陷阱越深。",
        "redFlag": 2
      },
      {
        "from": "scammer",
        "text": "加大投入博高收益，3万返5万，机会难得，下周漏洞就修复了。",
        "tactic": "加大收割+稀缺性",
        "psychology": ["greed", "scarcity", "sunkCost"],
        "deconstruct": "利用已建立的信任+紧迫感，诱导大额投入。'机会难得''即将修复'是标准催单话术。任何限时博高收益=诈骗。",
        "redFlag": 5
      },
      {
        "from": "victim",
        "text": "好，我转账3万，期待5万回报。",
        "tactic": "受害者深陷",
        "psychology": ["sunkCost", "greed"],
        "deconstruct": "受害者被甜头+情感双重裹挟，投入大额资金。此时账户余额是数字游戏，无法提现。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "提现需要缴8%个人所得税和5000反洗钱认证金，缴清后一次性到账。",
        "tactic": "连环收割",
        "psychology": ["sunkCost", "fear"],
        "deconstruct": "提现要交钱=100%诈骗。此时受害者已投入沉没成本，容易继续转账。正规平台税费自动扣除，无需额外缴纳。立即止损报警。",
        "redFlag": 5
      }
    ],
    "summary": {
      "totalRedFlags": 4,
      "keyCues": ["稳赚不赔", "保密参与", "内部消息", "提现缴税", "反洗钱认证金"],
      "victimProfile": "情感型+贪婪型受害者（单身、渴望情感、追求高收益）",
      "lesson": "优质异性带投资=杀猪盘，稳赚不赔+保密参与+提现缴税是连环套"
    }
  },
  {
    "id": "DC-002",
    "typeId": "F01",
    "type": "冒充公检法",
    "title": "涉嫌洗钱案：从警官来电到安全账户转账的完整剧本",
    "difficulty": 2,
    "scenario": "上班族接到自称公安局电话，被指控涉嫌洗钱，逐步被诱导转账自证清白",
    "duration": 12,
    "tags": ["冒充公检法", "电话办案", "安全账户", "恐吓"],
    "updateDate": "2026-07",
    "severity": 5,
    "script": [
      {
        "from": "system",
        "text": "午休时接到自称'市公安局刑侦支队'的电话，来电显示为带+号的境外号码。",
        "tactic": "来电伪装",
        "psychology": ["authority", "fear"],
        "deconstruct": "公检法不会用境外号码来电。+号开头、00开头都是境外号码，自称国内公检法的=诈骗。",
        "redFlag": 1
      },
      {
        "from": "scammer",
        "text": "你是XXX吗？身份证号XXXX，你名下银行卡涉嫌洗钱200万，现对你立案侦查。",
        "tactic": "权威压迫+精准信息",
        "psychology": ["authority", "fear"],
        "deconstruct": "骗子通过黑产获取你的精准信息制造可信度。但真警察不会电话立案，立案必当面送达文书。",
        "redFlag": 3
      },
      {
        "from": "victim",
        "text": "我没做过啊，这是怎么回事？",
        "tactic": "受害者恐慌",
        "psychology": ["fear"],
        "deconstruct": "受害者陷入恐慌，理性思考能力下降。骗子正是利用恐惧让你失去判断力。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "案件涉密，不能告诉任何人，包括家人和单位，否则追究你泄露机密的法律责任。",
        "tactic": "保密要求+恐吓",
        "psychology": ["fear", "conformity"],
        "deconstruct": "保密要求是切断你求助渠道的关键话术。真警察办案不会禁止你告知家人。任何'案件保密'都是诈骗。",
        "redFlag": 5
      },
      {
        "from": "scammer",
        "text": "加我QQ接收'逮捕令'和'通缉令'，你自己看看涉案多严重。",
        "tactic": "视觉恐吓",
        "psychology": ["authority", "fear"],
        "deconstruct": "骗子用PS的假文书恐吓你。真逮捕令由公安机关当面送达，不会通过QQ发送。看到'通缉令'截图=诈骗。",
        "redFlag": 4
      },
      {
        "from": "scammer",
        "text": "现在进行视频办案，你找个没人的房间，对着摄像头做笔录。",
        "tactic": "假冒办案流程",
        "psychology": ["authority", "fear"],
        "deconstruct": "公检法不进行视频办案，笔录必须当面进行。'视频办案''隔离做笔录'都是骗子让你与外界断联的手段。",
        "redFlag": 4
      },
      {
        "from": "victim",
        "text": "我配合调查，要怎么做才能证明清白？",
        "tactic": "受害者配合",
        "psychology": ["fear", "authority"],
        "deconstruct": "受害者急于自证清白，正中骗子下怀。记住：清白不需要用钱证明。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "把所有资金转入我们指定的'安全账户'清查，确认与案件无关后原路退回。",
        "tactic": "安全账户转账",
        "psychology": ["authority", "fear", "urgency"],
        "deconstruct": "不存在'安全账户'！这是诈骗核心话术。公安机关不会要求公民转账至任何账户。听到'安全账户'立即挂断。",
        "redFlag": 5
      },
      {
        "from": "scammer",
        "text": "下载'检务通'APP，按指引操作，全程配合我们的资金清查。",
        "tactic": "远程控制+假APP",
        "psychology": ["authority", "fear"],
        "deconstruct": "'检务通''公安认证'等APP全是假的，用于窃取你的银行信息或远程控制手机。正规办案不要求下载任何APP。",
        "redFlag": 5
      },
      {
        "from": "scammer",
        "text": "你晚一分钟转，就多一分钟涉案嫌疑，立即操作！",
        "tactic": "紧迫催促",
        "psychology": ["urgency", "fear"],
        "deconstruct": "骗子用紧迫感阻止你思考和核实。真警察会给你充分时间，不会催促转账。任何'立即转账'要求=诈骗。",
        "redFlag": 5
      },
      {
        "from": "victim",
        "text": "好，我现在就转，能不能晚点还给我？",
        "tactic": "受害者深陷",
        "psychology": ["fear", "authority"],
        "deconstruct": "受害者已被恐惧+权威双重裹挟，准备转账。这是最后止损窗口。",
        "redFlag": 0
      },
      {
        "from": "system",
        "text": "正确做法：挂断电话，立即拨打96110或到就近派出所核实。",
        "tactic": "正确应对",
        "psychology": ["trust"],
        "deconstruct": "96110是全国反诈专线。任何自称公检法的电话，都应挂断后通过96110或就近派出所核实。真警察会让你当面配合。",
        "redFlag": 0
      }
    ],
    "summary": {
      "totalRedFlags": 4,
      "keyCues": ["境外号码", "电话立案", "案件保密", "逮捕令", "视频办案", "安全账户", "检务通APP"],
      "victimProfile": "权威服从型受害者（遵纪守法、对公权力高度信任、缺乏反诈知识）",
      "lesson": "公检法不电话办案、无安全账户、无视频办案，任何要求转账的都是诈骗"
    }
  },
  {
    "id": "DC-003",
    "typeId": "F03",
    "type": "刷单返利",
    "title": "轻松兼职日入800：从点赞返佣到连环垫付的完整剧本",
    "difficulty": 3,
    "scenario": "大学生在兼职群看到点赞关注返佣，从5元小利到垫付数万的完整套路",
    "duration": 12,
    "tags": ["刷单", "垫付", "卡单", "解冻金"],
    "updateDate": "2026-07",
    "severity": 5,
    "script": [
      {
        "from": "system",
        "text": "兼职群看到广告：'点赞关注日结300-800，手机操作时间自由，无需押金'。",
        "tactic": "群内引流",
        "psychology": ["greed", "conformity"],
        "deconstruct": "刷单本身就是违法行为。任何'轻松高薪手机操作'的兼职都要警惕，群内多人晒单是骗子群演。",
        "redFlag": 2
      },
      {
        "from": "scammer",
        "text": "先做几单试试，关注这几个公众号，每单返5元，做完秒结。",
        "tactic": "小利试水",
        "psychology": ["greed", "trust"],
        "deconstruct": "前几单确实返钱，这是建立信任的关键。骗子用5元、10元钓大鱼。返佣越痛快，陷阱越大。",
        "redFlag": 2
      },
      {
        "from": "system",
        "text": "三单后，确实收到5元、8元、10元返佣，秒到账。",
        "tactic": "制造甜头",
        "psychology": ["trust", "sunkCost"],
        "deconstruct": "真实返现是骗局最强诱饵。但这5元、10元是诱饵成本，目的是让你垫付数千数万。",
        "redFlag": 2
      },
      {
        "from": "victim",
        "text": "还真给钱了，怎么赚更多？",
        "tactic": "受害者上钩",
        "psychology": ["greed"],
        "deconstruct": "受害者尝到甜头，主动求'升级'，进入垫付阶段。这是骗局转折点。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "现在做连单任务，垫付500返650，3分钟到账，比点赞赚得多多了。",
        "tactic": "垫付连单",
        "psychology": ["greed", "sunkCost"],
        "deconstruct": "从'点赞返佣'升级到'垫付任务'是刷单骗局的标志。任何需要你先垫钱的兼职都是诈骗。",
        "redFlag": 4
      },
      {
        "from": "victim",
        "text": "好，我垫付500，等返650。",
        "tactic": "受害者配合",
        "psychology": ["greed", "sunkCost"],
        "deconstruct": "受害者首次垫付，进入收割阶段。500元是新的诱饵。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "系统提示你操作失误导致任务卡单，需再垫付3000解冻，才能一并提现，否则本金无法退回。",
        "tactic": "卡单解冻",
        "psychology": ["fear", "sunkCost"],
        "deconstruct": "'操作失误''卡单''解冻金'是刷单诈骗标准话术。所谓失误是骗子编造的，目的是套更多钱。听到'卡单'立即止损。",
        "redFlag": 5
      },
      {
        "from": "victim",
        "text": "那我再垫3000解冻。",
        "tactic": "受害者深陷",
        "psychology": ["sunkCost", "fear"],
        "deconstruct": "受害者被沉没成本裹挟继续转账。记住：任何继续转账都是扩大损失。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "系统判定你操作超时，需再垫付8000才能一并提现，这是最后一次。",
        "tactic": "连环收割",
        "psychology": ["fear", "sunkCost", "urgency"],
        "deconstruct": "'最后一次'是标准话术，骗完这次还有下一次。提现门槛只会越来越高，永远提不出来。",
        "redFlag": 5
      },
      {
        "from": "scammer",
        "text": "不继续转账，本金全部作废，还会被起诉违约。",
        "tactic": "恐吓止损",
        "psychology": ["fear", "sunkCost"],
        "deconstruct": "骗子用'本金作废''起诉违约'恐吓你继续。实际上本金早已被吞，继续转账只会扩大损失。",
        "redFlag": 5
      },
      {
        "from": "victim",
        "text": "那我借钱也要解冻……",
        "tactic": "受害者深陷",
        "psychology": ["sunkCost", "fear"],
        "deconstruct": "受害者被'解冻就返现'的虚假承诺裹挟，开始借贷转账。这是倾家荡产的开端。",
        "redFlag": 0
      },
      {
        "from": "system",
        "text": "正确做法：识别'卡单''解冻'话术立即停止，保留证据报警。刷单本身违法，不受法律保护。",
        "tactic": "正确应对",
        "psychology": ["trust"],
        "deconstruct": "刷单兼职100%是诈骗，且刷单本身违法。任何需要垫付的兼职都是骗局，发现立即止损报警。",
        "redFlag": 0
      }
    ],
    "summary": {
      "totalRedFlags": 3,
      "keyCues": ["点赞返佣", "连单任务", "垫付", "操作失误", "卡单", "解冻金", "本金作废"],
      "victimProfile": "贪婪型+从众型受害者（学生、宝妈、求职者、急需副业收入）",
      "lesson": "刷单100%是诈骗，垫付即陷阱，'卡单解冻'是连环收割信号"
    }
  },
  {
    "id": "DC-004",
    "typeId": "F45",
    "type": "AI换脸冒充领导",
    "title": "领导视频急令代转账：AI换脸冒充CEO的完整剧本",
    "difficulty": 3,
    "scenario": "公司财务接到'CEO'微信，AI换脸视频通话后紧急要求代转客户款项",
    "duration": 12,
    "tags": ["AI换脸", "冒充领导", "代转账", "视频通话"],
    "updateDate": "2026-07",
    "severity": 5,
    "script": [
      {
        "from": "system",
        "text": "微信收到'王总'添加好友请求，头像与公司CEO本人一致，昵称显示'王XX-XX集团'。",
        "tactic": "假冒身份",
        "psychology": ["trust", "authority"],
        "deconstruct": "骗子盗用领导头像、昵称建假账号。收到'领导''客户'好友请求，必须通过原渠道核实身份。",
        "redFlag": 2
      },
      {
        "from": "scammer",
        "text": "小李，我在开重要会议不方便接电话，加你微信交代个事。",
        "tactic": "紧急情境+规避核实",
        "psychology": ["urgency", "authority"],
        "deconstruct": "'开会不便接电话'是规避语音核实的标准话术。真领导如有急事会自己打电话，不会让你无法回拨。",
        "redFlag": 3
      },
      {
        "from": "victim",
        "text": "王总好，有什么事？",
        "tactic": "受害者上钩",
        "psychology": ["authority", "trust"],
        "deconstruct": "受害者基于对领导的信任放下戒备。涉及转账必须多重核实，不能因对方是'领导'就放松警惕。",
        "redFlag": 0
      },
      {
        "from": "scammer",
        "text": "现在有个紧急客户款项5万要走你账户代转，会议结束我给你报销。",
        "tactic": "紧急转账",
        "psychology": ["urgency", "authority"],
        "deconstruct": "'紧急''代转''会议结束报销'是冒充领导三件套。任何领导通过新微信要求代转账都高度可疑。",
        "redFlag": 4
      },
